#lang racket/gui
;; §75.1: reparent (adopt-child), panel refresh cascade (register-child), frame icon.
;; Szene fuer tests/sweep/sweep.sh panel-api (Titel "sweep-panel-api").  Stderr-Log:
;;   [panel-api] parent-of-move-me ... / paints before/after (send panel refresh).
;; SWEEP_ICON=1 setzt per set-icon ein rotes 32x32-Icon (sonst Standard-PLT-Icons).
(define f (new frame% [label "sweep-panel-api"] [width 360] [height 200]))
(when (getenv "SWEEP_ICON")
  (define bm (make-bitmap 32 32))
  (define dc (new bitmap-dc% [bitmap bm]))
  (send dc set-brush "red" 'solid) (send dc draw-rectangle 0 0 32 32)
  (send dc set-bitmap #f)
  (send f set-icon bm))
(define row (new horizontal-panel% [parent f]))
(define a (new vertical-panel% [parent row] [style '(border)]))
(define b (new vertical-panel% [parent row] [style '(border)]))
(new message% [parent a] [label "Panel A"])
(new message% [parent b] [label "Panel B"])
(define move-me (new button% [parent a] [label "move-me"]))
(new button% [parent a] [label "stay in A"])
(define paints 0)
(define c (new (class canvas% (super-new) (define/override (on-paint) (set! paints (add1 paints)))) [parent a] [min-width 60] [min-height 30]))
(send f show #t)
(define (wait s) (define t (+ (current-inexact-milliseconds) (* 1000 s)))
  (let loop () (when (< (current-inexact-milliseconds) t) (sleep/yield 0.05) (loop))))
(wait 1)
(send move-me reparent b)
(wait 1)
(eprintf "[panel-api] move-me parent is B: ~a, children A=~a B=~a\n" (eq? (send move-me get-parent) b)
         (length (send a get-children)) (length (send b get-children)))
(define before paints)
(send a refresh)
(wait 1)
(eprintf "[panel-api] paints before=~a after (send a refresh)=~a\n" before paints)
(when (getenv "SWEEP_HOLD") (let loop () (wait 1) (loop)))
