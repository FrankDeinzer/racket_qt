;; Leak check for the callback records of the WASM proxy layer (HACKING §85.12), on the raw shim FFI:
;; re-registering a releasable callback must not grow the live-record count, destroying the window releases its records,
;; and a callback that was queued before it was replaced still runs (refcount keeps its record alive).
(require ffi/unsafe)
(define lib #f)
(define-syntax-rule (defshim id name type) (define id (get-ffi-obj name lib type)))
(define _cb (_fun #:atomic? #t _pointer -> _void))
(define _resize_cb (_fun #:atomic? #t _pointer _int _int -> _void))
(defshim rec-count "shim_rec_count" (_fun -> _int))
(defshim win-create "shim_window_create" (_fun _cb _pointer -> _pointer))
(defshim win-destroy "shim_window_destroy" (_fun _pointer -> _void))
(defshim set-resize "shim_window_set_resize_cb" (_fun _pointer _resize_cb _pointer -> _void))
(defshim win-resize "shim_window_set_size" (_fun _pointer _int _int -> _void))
(defshim win-show "shim_window_show" (_fun _pointer _int -> _void))
(defshim pump "shim_pump" (_fun _int -> _void))
(define base (rec-count))
(printf "REC base ~a\n" base)
(define fired 0)
(define keep '())   ; Racket closures must stay reachable while registered
(define win (win-create (lambda (ud) (void)) #f))
(printf "REC after create ~a\n" (rec-count))
(for ([i (in-range 2000)])
  (define cb (lambda (ud w h) (set! fired (add1 fired))))
  (set! keep (list cb))
  (set-resize win cb #f))
(pump 0)
(printf "REC after 2000 re-registrations ~a (expected base+2: close + resize)\n" (rec-count))
;; queued-then-replaced: trigger a resize (queues the callback), replace the callback at once, then pump
(win-show win 1)
(win-resize win 321 123)
(define cb2 (lambda (ud w h) (set! fired (add1 fired))))
(set! keep (list cb2))
(set-resize win cb2 #f)
(let loop ([n 0]) (when (< n 40) (pump 0) (sleep 0.05) (loop (add1 n))))
(printf "REC fired ~a\n" fired)
(win-show win 0)
(pump 0)
(win-destroy win)
(pump 0)
(printf "REC after destroy ~a (expected base)\n" (rec-count))
(printf "REC-DONE\n")
