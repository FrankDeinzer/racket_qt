;; Sampling-Profil für `insert` in einen angebundenen text%: Sampler-Thread liest die Kontinuationsmarken des Haupt-Threads.
(require racket/class racket/gui/base racket/list)
(define f (new frame% [label "ks"] [width 420] [height 300]))
(define ec (new editor-canvas% [parent f] [min-height 200]))
(define ed (new text%))
(send ec set-editor ed)
(send f show #t) (send ec focus) (sleep 1) (yield)
(define main (current-thread))
(define samples '())
(define running #t)
(define sampler
  (thread (lambda ()
            (let loop ()
              (when running
                (set! samples (cons (continuation-mark-set->context (continuation-marks main)) samples))
                (sleep 0.001) (loop))))))
(define t (current-inexact-milliseconds))
(for ([i 30]) (send ed insert "x"))
(set! running #f)
(printf "PROF ~a ms/op, ~a Samples\n" (/ (- (current-inexact-milliseconds) t) 30) (length samples))
(define (name fr) (let ([n (car fr)] [s (cdr fr)]) (format "~a ~a" (or n "?") (if s (let ([x (srcloc-source s)]) (format "~a:~a" (if (path? x) (let-values ([(b nm d) (split-path x)]) nm) x) (srcloc-line s))) ""))))
(define (top-count sel)
  (define h (make-hash))
  (for ([c samples]) (for ([n (remove-duplicates (sel c))]) (hash-update! h n add1 0)))
  (for ([p (take (sort (hash->list h) > #:key cdr) (min 22 (hash-count h)))]) (printf "PROF ~a  ~a\n" (cdr p) (car p))))
(printf "PROF -- innermost\n") (top-count (lambda (c) (if (null? c) '() (list (name (car c))))))
(printf "PROF -- inclusive\n") (top-count (lambda (c) (map name c)))
(printf "PROF-DONE\n")
(yield 'wait)
