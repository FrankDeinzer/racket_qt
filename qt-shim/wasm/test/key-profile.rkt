;; Wo gehen die ~290 ms pro Taste hin? Misst Editor-Operationen einzeln, mit und ohne angebundenen editor-canvas%.
(require racket/class racket/gui/base)
(define (ms) (current-inexact-milliseconds))
(define-syntax-rule (timed label n body ...)
  (let ([t (ms)]) (for ([i (in-range n)]) body ...)
    (printf "T ~a: ~a ms/op\n" label (/ (round (* 10 (/ (- (ms) t) n))) 10.0))))
(define ed0 (new text%))
(timed "insert ohne Canvas" 20 (send ed0 insert "x"))
(define f (new frame% [label "kp"] [width 420] [height 300]))
(define paint-ms 0.0) (define paint-n 0)
(define timed-ec%
  (class editor-canvas%
    (define/override (on-paint)
      (define t (ms)) (super on-paint)
      (set! paint-ms (+ paint-ms (- (ms) t))) (set! paint-n (add1 paint-n)))
    (super-new)))
(define ec (new timed-ec% [parent f] [min-height 200]))
(define ed (new text%))
(send ec set-editor ed)
(send f show #t)
(send ec focus)
(sleep 1) (yield)
(timed "insert mit Canvas, ohne Yield" 10 (send ed insert "y"))
(printf "T on-paint: ~a Aufrufe, ~a ms gesamt (Racket-Zeit)\n" paint-n (round paint-ms))
(define t1 (ms)) (send ed insert "q") (printf "T 1 insert: ~a ms, paints ~a\n" (round (- (ms) t1)) paint-n)
(timed "insert + Yield" 10 (send ed insert "z") (yield))
(timed "begin/end-edit-sequence insert" 10 (send ed begin-edit-sequence) (send ed insert "w") (send ed end-edit-sequence))
(timed "get-dc/flush leer" 20 (send (send ec get-dc) get-size))
(timed "refresh Canvas" 10 (send ec refresh))
(timed "yield leer" 10 (yield))
(printf "KP-DONE\n")
(yield 'wait)
