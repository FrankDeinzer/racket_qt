;; Does evaluating code work in the WASM runtime, independent of DrRacket?  (HACKING §85.14)
(define t0 (current-inexact-milliseconds))
(define (lap what) (printf "EVAL ~a: ~a ms\n" what (round (- (current-inexact-milliseconds) t0))))
(define (try what thunk)
  (with-handlers ([void (lambda (e) (printf "EVAL ~a FAILED: ~a\n" what (if (exn? e) (exn-message e) e)))])
    (define r (thunk)) (lap (format "~a -> ~s" what r))))
(try "base ns eval" (lambda () (eval '(+ 1 2) (make-base-namespace))))
(try "namespace-require racket/base" (lambda () (parameterize ([current-namespace (make-base-empty-namespace)]) (namespace-require 'racket/base) (eval '(* 6 7)))))
(try "namespace-require racket" (lambda () (parameterize ([current-namespace (make-base-empty-namespace)]) (namespace-require 'racket) (eval '(length (list 1 2 3))))))
(try "module eval #lang racket" (lambda ()
  (parameterize ([current-namespace (make-base-namespace)] [read-accept-reader #t])
    (define code (read (open-input-string "(module m racket (provide x) (define x (+ 1 2)))")))
    (eval code) (dynamic-require ''m 'x))))
(try "thread + custodian" (lambda () (define c (make-custodian)) (define ch (make-channel))
  (parameterize ([current-custodian c]) (thread (lambda () (channel-put ch 'ok))))
  (begin0 (sync/timeout 5 ch) (custodian-shutdown-all c))))
(try "custodian-limit-memory" (lambda () (define c (make-custodian)) (custodian-limit-memory c (* 128 1024 1024) c) #t))
(try "make-place" (lambda () (dynamic-require 'racket/place 'place) #t))
(lap "done")
(printf "EVAL-DONE\n")
