;; Kitchen sink for racket/gui on the Qt backend in the browser (WASM): menus, tab-panel, the common controls, an editor,
;; a canvas, a popup menu and a modal dialog.  Every step logs "CHK <name> OK|FAIL <detail>" so the run is self-reporting;
;; the screenshot (serve-and-run) shows what actually rendered.
(require racket/class racket/gui/base)
(define t0 (current-inexact-milliseconds))
(define (ms) (round (- (current-inexact-milliseconds) t0)))
(define (chk name thunk)
  (define t (current-inexact-milliseconds))
  (with-handlers ([(lambda (e) #t) (lambda (e) (printf "CHK ~a FAIL ~a\n" name (if (exn? e) (exn-message e) e)))])
    (define r (thunk))
    (printf "CHK ~a ~a (~a ms)~a\n" name (if r "OK" "FAIL") (round (- (current-inexact-milliseconds) t))
            (if (or (not r) (eq? r #t)) "" (format " ~s" r)))))

(define f (new frame% [label "Kitchen sink"] [width 640] [height 460]))
(define mb (new menu-bar% [parent f]))
(define file-menu (new menu% [label "&File"] [parent mb]))
(define clicks '())
(define (note s) (set! clicks (cons s clicks)) (printf "NOTE ~s\n" s))
(define open-item (new menu-item% [label "Open…"] [parent file-menu] [shortcut #\O] [callback (lambda (i e) (note 'open))]))
(new separator-menu-item% [parent file-menu])
(define chk-item (new checkable-menu-item% [label "Check me"] [parent file-menu] [callback (lambda (i e) (note 'check))]))
(define edit-menu (new menu% [label "&Edit"] [parent mb]))
(define sub (new menu% [label "Sub"] [parent edit-menu]))
(define sub-item (new menu-item% [label "Nested"] [parent sub] [callback (lambda (i e) (note 'nested))]))
(define tabs (new tab-panel% [parent f] [choices '("Controls" "Editor" "Canvas" "List")]
                  [callback (lambda (tp e) (note (list 'tab (send tp get-selection))))]))
;; tab 0 content pane; others are swapped in by the callback (the usual tab-panel idiom)
(define pane (new vertical-panel% [parent tabs]))
(define row1 (new horizontal-panel% [parent pane] [stretchable-height #f]))
(define tf (new text-field% [parent row1] [label "Name"] [init-value "racket"] [callback (lambda (t e) (note (list (quote text) (send t get-value))))]))
(define ch (new choice% [parent row1] [label "Pick"] [choices '("one" "two" "three")]))
(define row2 (new horizontal-panel% [parent pane] [stretchable-height #f]))
(define sl (new slider% [parent row2] [label "Vol"] [min-value 0] [max-value 100] [init-value 30]))
(define gg (new gauge% [parent row2] [label "Prog"] [range 100]))
(define row3 (new horizontal-panel% [parent pane] [stretchable-height #f]))
(define cb (new check-box% [parent row3] [label "Enable"] [value #t]))
(define rb (new radio-box% [parent row3] [label "Mode"] [choices '("A" "B" "C")]))
(define btn (new button% [parent row3] [label "Go"] [callback (lambda (b e) (note 'go))]))
(define ed (new text%))
(define ec (new editor-canvas% [parent pane] [editor ed] [min-height 80]))
(define cv (new canvas% [parent pane] [min-height 70]
                [paint-callback (lambda (c dc)
                                  (send dc set-brush "steelblue" 'solid)
                                  (send dc draw-ellipse 10 5 80 55)
                                  (send dc draw-text "canvas" 100 20))]))
(define lb (new list-box% [parent pane] [label "Items"] [choices '("alpha" "beta" "gamma" "delta")] [min-height 90]
                [callback (lambda (l e) (note (list 'list (send l get-selections))))]))
(send f show #t)
(printf "CHK frame-shown OK (~a ms)\n" (ms))

(define (settle) (yield) (sleep 0.3) (yield))
(settle)
(chk "text-field value" (lambda () (equal? (send tf get-value) "racket")))
(chk "text-field set" (lambda () (send tf set-value "wasm") (equal? (send tf get-value) "wasm")))
(chk "choice select" (lambda () (send ch set-selection 2) (= (send ch get-selection) 2)))
(chk "choice string" (lambda () (equal? (send ch get-string-selection) "three")))
(chk "slider set" (lambda () (send sl set-value 75) (= (send sl get-value) 75)))
(chk "gauge set" (lambda () (send gg set-value 40) (= (send gg get-value) 40)))
(chk "check-box" (lambda () (send cb set-value #f) (not (send cb get-value))))
(chk "radio-box" (lambda () (send rb set-selection 1) (= (send rb get-selection) 1)))
(chk "list-box select" (lambda () (send lb set-selection 2) (equal? (send lb get-selections) '(2))))
(chk "list-box append" (lambda () (send lb append "epsilon") (= (send lb get-number) 5)))
(chk "list-box string" (lambda () (equal? (send lb get-string 4) "epsilon")))
(chk "editor insert" (lambda () (send ed insert "hello editor") (equal? (send ed get-text) "hello editor")))
(chk "editor undo-less select-all" (lambda () (send ed select-all) (> (- (send ed get-end-position) (send ed get-start-position)) 0)))
(chk "button click (callback)" (lambda () (send btn command (new control-event% [event-type 'button])) (settle) (memq 'go clicks)))
(chk "menu item command" (lambda () (send open-item command (new control-event% [event-type 'menu])) (settle) (memq 'open clicks)))
(chk "checkable menu" (lambda () (send chk-item check #t) (send chk-item is-checked?)))
(chk "submenu item" (lambda () (send sub-item command (new control-event% [event-type 'menu])) (settle) (memq 'nested clicks)))
(chk "tab switch" (lambda () (send tabs set-selection 2) (settle) (= (send tabs get-selection) 2)))
(chk "frame resize" (lambda () (send f resize 700 500) (settle) (let-values ([(w h) (send f get-size)]) (list w h))))
(chk "get-text-extent" (lambda () (let-values ([(w h d a) (send (send cv get-dc) get-text-extent "hello")]) (> w 0))))
(chk "popup-menu" (lambda ()
  (define pm (new popup-menu%))
  (new menu-item% [label "P1"] [parent pm] [callback (lambda (i e) (note 'p1))])
  (thread (lambda () (sleep 0.5) (void)))   ; close it again: popup is non-blocking here
  (send f popup-menu pm 100 100) (settle) #t))
(chk "message-box (modal, auto-closed)" (lambda ()
  (define d #f)
  (thread (lambda () (sleep 1)
            (for ([w (get-top-level-windows)]) (when (and (not (eq? w f)) (send w is-shown?)) (send w show #f)))))
  (message-box "Title" "Hello from a modal dialog" f '(ok))
  #t))
(chk "dialog% create/show/hide" (lambda ()
  (define dlg (new dialog% [label "D"] [parent f] [width 200] [height 100]))
  (new button% [parent dlg] [label "Close"] [callback (lambda (b e) (send dlg show #f))])
  (thread (lambda () (sleep 0.5) (send dlg show #f)))
  (send dlg show #t) #t))
(settle)
(printf "CHK-ALL-DONE ~a ms\n" (ms))
(yield 'wait)
