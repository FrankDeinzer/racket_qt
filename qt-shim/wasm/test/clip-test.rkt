;; What does the Racket side see on the clipboard after a browser paste event?  (HACKING §85.16)
(require racket/class racket/gui/base)
(define f (new frame% [label "clip"] [width 200] [height 100]))
(send f show #t)
(for ([i 40])
  (printf "CLIP ~a: ~s\n" i (send the-clipboard get-clipboard-string 0))
  (sleep 0.5) (yield))
(printf "CLIP-DONE\n")
(yield 'wait)
