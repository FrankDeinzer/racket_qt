#lang racket/gui
;; Optik-Matrix (docs/COVERAGE.md "Optik (OP)", HACKING §84): pro Widget-Klasse eine Szene in
;; einem eigenen Fenster "vm-<szene>" (natuerliche Groesse, feste Inhalte, keine Animation).
;; Nach 1,8 s schreibt die Probe das Geometrie-Protokoll auf stderr (diffbar, eine Zeile je Fenster/Kind):
;;   <szene> <pfad> <klasse> "<label>" x y w h minw minh shown
;; Pfad "frame" = Top-Level (w/h = Client-Groesse), "0/2" = drittes Kind des ersten Kindes ...
;; Aufruf: racket examples/visual-matrix-probe.rkt <szene>   |   ... list
;; Treiber (Screenshots, Vergleich nativ/Qt): tests/sweep/visual-matrix.sh
(define scene (let ([a (current-command-line-arguments)]) (if (zero? (vector-length a)) "list" (vector-ref a 0))))
(define scenes (make-hash))
(define order '())
(define-syntax-rule (defscene name (f) body ...)
  (begin (set! order (cons name order)) (hash-set! scenes name (λ (f) (let () body ... (void))))))

(define (bmp w h [color "red"])
  (define b (make-bitmap w h))
  (define dc (send b make-dc))
  (send dc set-brush color 'solid) (send dc set-pen "black" 1 'solid)
  (send dc draw-rectangle 0 0 w h)
  (send dc draw-line 0 0 w h)
  b)
(define (frame* [style '()]) (new frame% [label (string-append "vm-" scene)] [style style]))
(define lorem "A rather long label that is clearly wider than the usual control, to test truncation")

;; ---------------- Steuerelemente ----------------
(defscene "button" (f)
  (define p (new vertical-panel% [parent f]))
  (new button% [parent p] [label "Normal"])
  (new button% [parent p] [label "Disabled"] [enabled #f])
  (new button% [parent p] [label "Default (border)"] [style '(border)])
  (new button% [parent p] [label lorem])
  (new button% [parent p] [label (bmp 24 16)])
  (new button% [parent p] [label (list (bmp 16 16 "green") "Icon + Text" 'left)])
  (new button% [parent p] [label "Stretch"] [stretchable-width #t]))

(defscene "check-box" (f)
  (define p (new vertical-panel% [parent f]))
  (new check-box% [parent p] [label "On"] [value #t])
  (new check-box% [parent p] [label "Off"])
  (new check-box% [parent p] [label "Disabled on"] [value #t] [enabled #f])
  (new check-box% [parent p] [label "Disabled off"] [enabled #f])
  (new check-box% [parent p] [label lorem]))

(defscene "radio-box" (f)
  (define p (new vertical-panel% [parent f]))
  (new radio-box% [parent p] [label "Vertical, labelled"] [choices '("one" "two" "three")])
  (new radio-box% [parent p] [label #f] [choices '("no label a" "no label b")])
  (new radio-box% [parent p] [label "Horizontal"] [choices '("a" "b" "c")] [style '(horizontal)])
  (new radio-box% [parent p] [label #f] [choices '("h1" "h2")] [style '(horizontal)])
  (new radio-box% [parent p] [label "Vertical label"] [choices '("x" "y")] [style '(vertical vertical-label)])
  (new radio-box% [parent p] [label "Disabled"] [choices '("p" "q")] [enabled #f]))

(defscene "choice" (f)
  (define p (new vertical-panel% [parent f]))
  (new choice% [parent p] [label "Labelled"] [choices '("alpha" "beta" "gamma")])
  (new choice% [parent p] [label #f] [choices '("no label" "b")])
  (new choice% [parent p] [label "Long entry"] [choices (list lorem "b")])
  (new choice% [parent p] [label "Disabled"] [choices '("x")] [enabled #f])
  (new choice% [parent p] [label "Vertical label"] [choices '("x" "y")] [style '(vertical-label)]))

(defscene "slider" (f)
  (define p (new vertical-panel% [parent f]))
  (new slider% [parent p] [label "Horizontal"] [min-value 0] [max-value 100] [init-value 40])
  (new slider% [parent p] [label #f] [min-value 0] [max-value 10] [init-value 5])
  (new slider% [parent p] [label "No value"] [min-value 0] [max-value 100] [init-value 70] [style '(horizontal plain)])
  (new slider% [parent p] [label "Disabled"] [min-value 0] [max-value 100] [init-value 20] [enabled #f])
  (define h (new horizontal-panel% [parent p]))
  (new slider% [parent h] [label "Vertical"] [min-value 0] [max-value 100] [init-value 30] [style '(vertical)] [min-height 100] [stretchable-width #f])
  (new slider% [parent h] [label #f] [min-value -50] [max-value 50] [init-value 0] [style '(vertical plain)] [min-height 100] [stretchable-width #f]))

(defscene "gauge" (f)
  (define p (new vertical-panel% [parent f]))
  (define (g label v . st) (define x (new gauge% [parent p] [label label] [range 100] [style (if (null? st) '(horizontal) st)])) (send x set-value v) x)
  (g "0%" 0) (g "50%" 50) (g "100%" 100) (g #f 25)
  (define h (new horizontal-panel% [parent p]))
  (define (gv label v) (define x (new gauge% [parent h] [label label] [range 100] [style '(vertical)] [stretchable-height #f] [min-height 80])) (send x set-value v))
  (gv "v0" 0) (gv "v60" 60) (gv #f 100) (gv "v-disabled" 40))

(defscene "message" (f)
  (define p (new vertical-panel% [parent f]))
  (new message% [parent p] [label "Plain"])
  (new message% [parent p] [label lorem])
  (new message% [parent p] [label "Disabled"] [enabled #f])
  (define c (new message% [parent p] [label "Colored (blue)"]))
  (send c set-color (make-object color% 0 0 255))
  (new message% [parent p] [label 'caution])
  (new message% [parent p] [label 'stop])
  (new message% [parent p] [label 'app])
  (new message% [parent p] [label (bmp 40 20 "orange")])
  (new message% [parent p] [label "Bold"] [font (make-object font% 12 'default 'normal 'bold)]))

(defscene "text-field" (f)
  (define p (new vertical-panel% [parent f]))
  (new text-field% [parent p] [label "Single"] [init-value "hello"])
  (new text-field% [parent p] [label #f] [init-value "no label"])
  (new text-field% [parent p] [label "Vertical label"] [init-value "x"] [style '(single vertical-label)])
  (new text-field% [parent p] [label "Disabled"] [init-value "off"] [enabled #f])
  (new text-field% [parent p] [label "Password"] [init-value "secret"] [style '(single password)])
  (new text-field% [parent p] [label "Multi"] [init-value "line1\nline2\nline3"] [style '(multiple)] [min-height 60])
  (new text-field% [parent p] [label "Multi hscroll"] [init-value (string-append lorem lorem)] [style '(multiple hscroll)] [min-height 60]))

(defscene "combo-field" (f)
  (define p (new vertical-panel% [parent f]))
  (new combo-field% [parent p] [label "Labelled"] [choices '("x" "y" "z")] [init-value "combo"])
  (new combo-field% [parent p] [label #f] [choices '("a" "b")] [init-value "no label"])
  (new combo-field% [parent p] [label "Disabled"] [choices '("a")] [init-value "off"] [enabled #f])
  (new combo-field% [parent p] [label "Vertical label"] [choices '("a")] [init-value "v"] [style '(vertical-label)]))

(defscene "list-box" (f)
  (define p (new vertical-panel% [parent f]))
  (new list-box% [parent p] [label "Single"] [choices '("red" "green" "blue" "cyan")] [min-height 80])
  (new list-box% [parent p] [label #f] [choices '("no label 1" "2" "3" "4" "5" "6" "7" "8")] [style '(multiple)] [min-height 80])
  (define lb (new list-box% [parent p] [label "Columns + header"] [choices '()]
                  [style '(single column-headers)] [columns '("Name" "Kind" "Size")] [min-height 90]))
  (send lb set '("alpha" "beta" "gamma") '("a" "b" "c") '("1" "2" "3"))
  (new list-box% [parent p] [label "Disabled"] [choices '("x" "y")] [enabled #f] [min-height 50]))

(defscene "tab-panel" (f)
  (define p (new vertical-panel% [parent f]))
  (define t1 (new tab-panel% [parent p] [choices '("First" "Second" "Third")] [min-height 70]))
  (new message% [parent t1] [label "Plain tab-panel content"])
  (define t2 (new tab-panel% [parent p] [choices '("A" "B")] [style '(can-close can-reorder)] [min-height 70]))
  (new button% [parent t2] [label "Button in tab"])
  (define t3 (new tab-panel% [parent p] [choices (list "A tab with a quite long label" "x")] [min-height 50])))

(defscene "group-panel" (f)
  (define p (new vertical-panel% [parent f]))
  (define g1 (new group-box-panel% [parent p] [label "Group label"]))
  (new button% [parent g1] [label "inside"]) (new check-box% [parent g1] [label "check"])
  (define g2 (new group-box-panel% [parent p] [label ""]))
  (new message% [parent g2] [label "empty label"])
  (define g3 (new group-box-panel% [parent p] [label "Horizontal inside"]))
  (define h (new horizontal-panel% [parent g3]))
  (new button% [parent h] [label "a"]) (new button% [parent h] [label "b"])
  (define g4 (new group-box-panel% [parent p] [label lorem]))
  (new message% [parent g4] [label "long label"]))

(defscene "panel-border" (f)
  (define p (new vertical-panel% [parent f]))
  (define a (new vertical-panel% [parent p] [style '(border)]))
  (new message% [parent a] [label "panel% 'border"])
  (define b (new horizontal-panel% [parent p] [style '(border)] [border 8] [spacing 10]))
  (new button% [parent b] [label "with"]) (new button% [parent b] [label "border 8"])
  (define c (new vertical-panel% [parent p] [style '(border)] [stretchable-height #f]))
  (new message% [parent c] [label "no-stretch border"])
  (define d (new vertical-panel% [parent p]))
  (new message% [parent d] [label "no border (reference)"]))

(define (paint-text t) (λ (c dc) (send dc draw-text t 4 4)))
(defscene "canvas" (f)
  (define p (new vertical-panel% [parent f]))
  (define (cv t st) (new canvas% [parent p] [style st] [min-width 220] [min-height 48] [paint-callback (paint-text t)]))
  (cv "plain" '()) (cv "'border" '(border)) (cv "'control-border" '(control-border))
  (define h (new horizontal-panel% [parent p]))
  (define v (new canvas% [parent h] [style '(vscroll)] [min-width 120] [min-height 80] [paint-callback (paint-text "vscroll")]))
  (send v init-manual-scrollbars #f 300 10 10 0 0)
  (define hs (new canvas% [parent h] [style '(hscroll)] [min-width 120] [min-height 80] [paint-callback (paint-text "hscroll")]))
  (send hs init-manual-scrollbars 400 #f 10 10 0 0)
  (define both (new canvas% [parent h] [style '(vscroll hscroll border)] [min-width 120] [min-height 80] [paint-callback (paint-text "both")]))
  (send both init-manual-scrollbars 400 300 10 10 0 0)
  (define ed (new text%)) (send ed insert "editor-canvas\nsecond line")
  (new editor-canvas% [parent p] [editor ed] [min-height 50])
  (new editor-canvas% [parent p] [editor ed] [min-height 50] [style '(no-border)]))

;; ---------------- Layout ----------------
(defscene "layout-align" (f)
  (define p (new vertical-panel% [parent f] [min-width 360]))
  (define (row al) (define r (new horizontal-panel% [parent p] [alignment al] [style '(border)] [stretchable-height #f]))
    (new button% [parent r] [label (format "~a" al)]) (new button% [parent r] [label "b2"]) r)
  (row '(left center)) (row '(center center)) (row '(right center))
  (define c (new vertical-panel% [parent p] [alignment '(right top)] [style '(border)] [min-height 90]))
  (new button% [parent c] [label "right/top"]) (new button% [parent c] [label "b2"])
  (define c2 (new vertical-panel% [parent p] [alignment '(center bottom)] [style '(border)] [min-height 90]))
  (new button% [parent c2] [label "center/bottom"]) (new button% [parent c2] [label "b2"]))

(defscene "layout-spacing" (f)
  (define p (new vertical-panel% [parent f]))
  (define a (new horizontal-panel% [parent p] [spacing 0] [border 0] [style '(border)] [stretchable-height #f]))
  (for ([i 3]) (new button% [parent a] [label (format "s0-~a" i)]))
  (define b (new horizontal-panel% [parent p] [spacing 20] [border 0] [style '(border)] [stretchable-height #f]))
  (for ([i 3]) (new button% [parent b] [label (format "s20-~a" i)]))
  (define c (new horizontal-panel% [parent p] [spacing 4] [border 15] [style '(border)] [stretchable-height #f]))
  (for ([i 3]) (new button% [parent c] [label (format "b15-~a" i)]))
  (define d (new vertical-panel% [parent p] [spacing 12] [border 6] [style '(border)]))
  (for ([i 3]) (new button% [parent d] [label (format "v12-~a" i)]))
  (define e (new vertical-panel% [parent p] [horiz-margin 20] [vert-margin 10] [style '(border)] [stretchable-height #f]))
  (new button% [parent e] [label "margins 20/10"]))

(defscene "layout-stretch" (f)
  (define p (new vertical-panel% [parent f] [min-width 380] [min-height 300]))
  (define h (new horizontal-panel% [parent p]))
  (new button% [parent h] [label "fixed"] [stretchable-width #f])
  (new button% [parent h] [label "stretch"] [stretchable-width #t])
  (new button% [parent h] [label "fixed2"] [stretchable-width #f])
  (new button% [parent p] [label "wide stretch, fixed height"] [stretchable-width #t] [stretchable-height #f])
  (define h2 (new horizontal-panel% [parent p]))
  (new canvas% [parent h2] [style '(border)] [min-width 50] [min-height 40])
  (new canvas% [parent h2] [style '(border)] [min-width 50] [min-height 40] [stretchable-width #f])
  (new canvas% [parent h2] [style '(border)] [min-width 50] [min-height 40])
  (define sub (new vertical-panel% [parent p] [style '(border)] [stretchable-height #f]))
  (new message% [parent sub] [label "nested, no vertical stretch"])
  (new vertical-pane% [parent p]))

;; ---------------- Fenster ----------------
(defscene "frame-menubar" (f)
  (define mb (new menu-bar% [parent f]))
  (define m1 (new menu% [label "&File"] [parent mb]))
  (new menu-item% [label "New"] [parent m1] [callback void] [shortcut #\N])
  (new menu-item% [label "Open..."] [parent m1] [callback void] [shortcut #\O])
  (new separator-menu-item% [parent m1])
  (new checkable-menu-item% [label "Checked"] [parent m1] [callback void] [checked #t])
  (send (new menu-item% [label "Disabled"] [parent m1] [callback void]) enable #f)
  (define sub (new menu% [label "Submenu"] [parent m1]))
  (new menu-item% [label "Inner"] [parent sub] [callback void])
  (define m2 (new menu% [label "&Edit"] [parent mb]))
  (new menu-item% [label "Copy"] [parent m2] [callback void] [shortcut #\C])
  (new menu% [label "&Help"] [parent mb])
  (new button% [parent f] [label "content"]))

(defscene "frame-plain" (f)
  (new button% [parent f] [label "No menu bar"]))

(defscene "frame-explicit" (f)
  (send f resize 300 200)
  (new button% [parent f] [label "Explicit 300x200"] [stretchable-width #t] [stretchable-height #t]))

(defscene "frame-nocaption" (f)
  (new message% [parent f] [label "'no-caption frame"])
  (new button% [parent f] [label "button"]))

(defscene "dialog" (f)
  (void))

;; ---------------- Fonts ----------------
(defscene "fonts" (f)
  (define p (new vertical-panel% [parent f]))
  (define (row name font)
    (define r (new horizontal-panel% [parent p] [stretchable-height #f]))
    (new message% [parent r] [label (format "~a" name)] [font font])
    (new button% [parent r] [label "Button"] [font font])
    (new check-box% [parent r] [label "Check"] [font font])
    (new choice% [parent r] [label #f] [choices '("Choice")] [font font]))
  (row "small-control-font" small-control-font)
  (row "normal-control-font" normal-control-font)
  (row "view-control-font" view-control-font)
  (row "tiny-control-font" tiny-control-font)
  (row "bold 14" (make-object font% 14 'default 'normal 'bold))
  (row "serif 9" (make-object font% 9 'roman 'normal 'normal))
  (row "mono 18" (make-object font% 18 'modern 'normal 'normal))
  (new text-field% [parent p] [label "text-field"] [init-value "plain text"] [font (make-object font% 16 'default)]))

;; ---------------- Menues (geoeffnet) ----------------
(defscene "popup-menu" (f)
  (define c (new canvas% [parent f] [min-width 260] [min-height 200] [paint-callback (paint-text "popup at (10,10)")]))
  (define m (new popup-menu%))
  (new menu-item% [label "First"] [parent m] [callback void])
  (new menu-item% [label "Second"] [parent m] [callback void])
  (new separator-menu-item% [parent m])
  (new checkable-menu-item% [label "Checked"] [parent m] [callback void] [checked #t])
  (send (new menu-item% [label "Disabled"] [parent m] [callback void]) enable #f)
  (define sub (new menu% [label "Submenu"] [parent m]))
  (new menu-item% [label "Inner"] [parent sub] [callback void])
  (new timer% [interval 2300] [just-once? #t]
       [notify-callback (λ () (send c popup-menu m 10 10))]))

(defscene "menubar-open" (f)
  ((hash-ref scenes "frame-menubar") f)
  (send f min-width 300) (send f min-height 200))

;; ---------------- Protokoll ----------------
(define (s x) (cond [(string? x) x] [else ""]))
(define (report f)
  (define (line path w)
    (define-values (mw mh) (with-handlers ([void (λ (e) (values -1 -1))]) (send w get-graphical-min-size)))
    (define lbl (with-handlers ([void (λ (e) "")])
                  (let ([l (if (is-a? w tab-panel%) (send w get-item-label 0) (send w get-label))]) (s l))))
    (define-values (cw ch) (if (is-a? w area-container<%>) (send w get-client-size) (values 0 0)))
    (eprintf "~a ~a ~a ~s ~a ~a ~a ~a ~a ~a ~a\n" scene path
             (regexp-replace #rx"^object:" (format "~a" (object-name w)) "")
             lbl (send w get-x) (send w get-y) (send w get-width) (send w get-height) mw mh (send w is-shown?)))
  (define (walk w path)
    (line path w)
    (when (is-a? w area-container<%>)
      (for ([c (send w get-children)] [i (in-naturals)]) (walk c (format "~a/~a" path i)))))
  (define-values (cw ch) (send f get-client-size))
  (eprintf "~a frame frame% ~s 0 0 ~a ~a 0 0 #t\n" scene (s (send f get-label)) cw ch)
  (for ([c (send f get-children)] [i (in-naturals)]) (walk c (format "~a" i)))
  (eprintf "~a END\n" scene))

(cond
  [(equal? scene "list") (for ([n (reverse order)]) (displayln n))]
  [(hash-ref scenes scene #f)
   => (λ (build)
        (define f (if (equal? scene "frame-nocaption") (frame* '(no-caption))
                      (if (equal? scene "dialog") #f (frame*))))
        (cond
          [f (build f)
             (new timer% [interval 1800] [just-once? #t] [notify-callback (λ () (report f))])
             (send f show #t)]
          [else
           (define d (new dialog% [label (string-append "vm-" scene)]))
           (new message% [parent d] [label "Dialog message"])
           (new text-field% [parent d] [label "Name"] [init-value "x"])
           (define h (new horizontal-panel% [parent d] [alignment '(right center)]))
           (new button% [parent h] [label "Cancel"])
           (new button% [parent h] [label "OK"] [style '(border)])
           (new timer% [interval 1800] [just-once? #t] [notify-callback (λ () (report d))])
           (send d show #t)]))]
  [else (eprintf "unbekannte Szene ~a\n" scene) (exit 2)])
