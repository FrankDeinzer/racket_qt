(define-syntax-rule (R-dyn key e)
  (let ([v (with-handlers ([(λ (x) #t) (λ (x) (format "EXN ~a" (if (exn? x) (car (regexp-split #rx"\n" (exn-message x))) x)))]) e)])
    (printf "~a ~a => ~s\n" (current-section) key v) (flush-output)))
(define (sec-timer)
  (parameterize ([current-section "timer"])
    (define n 0)
    (define t (new timer% [notify-callback (λ () (set! n (add1 n)))]))
    (R init:interval (send t interval))
    (send t start 40) (settle 0.6)
    (R repeating:>=5 (>= n 5))
    (R repeating:interval (send t interval))
    (send t stop) (define n1 n) (settle 0.3)
    (R stopped:no-more (= n n1))
    (set! n 0) (send t start 50 #t) (settle 0.5)
    (R one-shot:exactly-1 n)
    (send t start 100) (send t start 100) (settle 0.5) (send t stop)
    (R restart:ok #t)
    ;; Queue-Reihenfolge
    (define order '())
    (queue-callback (λ () (set! order (cons 1 order))))
    (queue-callback (λ () (set! order (cons 2 order))))
    (queue-callback (λ () (set! order (cons 'hi order))) #t)
    (settle 0.2)
    (R queue-order (reverse order))
    (R sleep/yield-nonblocking (let ([t0 (current-inexact-milliseconds)]) (sleep/yield 0.1) (>= (- (current-inexact-milliseconds) t0) 90)))
    ;; Timer ohne Referenz + GC
    (set! n 0) (let ([t2 (new timer% [notify-callback (λ () (set! n (add1 n)))])]) (send t2 start 30)) (collect-garbage) (settle 0.3)
    (R gc-live-timer-still-fires (> n 0))
    (R current-eventspace-event-dispatch (eq? (current-eventspace) (current-eventspace)))))
