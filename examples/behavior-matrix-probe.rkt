;; ---- Layout-Relationen (pixel-unabhaengig): Kinder fuellen Container, Reihenfolge, Resize, Hide ----
(define (sec-layout)
  (parameterize ([current-section "layout"])
    (hash-clear! counts)
    (define f (new frame% [label "layout"] [width 500] [height 400]))
    (define vp (new vertical-panel% [parent f]))
    (define hp (new horizontal-panel% [parent vp] [stretchable-height #f]))
    (define b1 (new button% [parent hp] [label "one"]))
    (define c1 (new (L canvas% 'c1) [parent hp] [min-width 40] [min-height 20]))
    (define b2 (new button% [parent hp] [label "two"]))
    (define c2 (new (L canvas% 'c2) [parent vp] [min-width 40] [min-height 40]))
    (define (rel tag)
      (define-values (fcw fch) (send f get-client-size))
      (R-dyn (string-append tag ":hp-fills-client-width") (= (send hp get-width) fcw))
      (R-dyn (string-append tag ":hp-children-sum=hp-width")
             (= (apply + (for/list ([c (send hp get-children)] #:when (send c is-shown?)) (send c get-width))) (send hp get-width)))
      (R-dyn (string-append tag ":c2-fills-rest") (= (+ (send hp get-height) (send c2 get-height)) (send vp get-height)))
      (R-dyn (string-append tag ":vp-fills-client") (list (= (send vp get-width) fcw) (= (send vp get-height) fch)))
      (R-dyn (string-append tag ":order-x") (let ([xs (for/list ([c (list b1 c1 b2)] #:when (send c is-shown?)) (send c get-x))]) (equal? xs (sort xs <))))
      (R-dyn (string-append tag ":c2-below-hp") (>= (send c2 get-y) (+ (send hp get-y) (send hp get-height)))))
    (send f show #t) (settle 0.6)
    (rel "initial")
    (R initial:c1-on-size>=1 (>= (cnt 'c1 'size) 1))
    (define cw0 (send c1 get-width))
    (hash-clear! counts)
    (send f resize 700 520) (settle 0.6)
    (rel "resized")
    (R resized:c1-grew-by-200 (- (send c1 get-width) cw0))
    (R resized:c1-on-size (cnt 'c1 'size))
    (R resized:c2-on-size (cnt 'c2 'size))
    (send b1 show #f) (settle 0.4)
    (rel "b1-hidden")
    (R b1-hidden:c1-grew (> (send c1 get-width) (- cw0 1)))
    (send b1 show #t) (settle 0.4)
    (rel "b1-shown")
    (send hp show #f) (settle 0.4)
    (R hp-hidden:c2-fills-vp (= (send c2 get-height) (send vp get-height)))
    (send hp show #t) (settle 0.4)
    (rel "hp-shown")
    (send hp stretchable-height #t) (settle 0.4)
    (rel "hp-stretchy")
    (R hp-stretchy:heights-equal-ish (<= (abs (- (send hp get-height) (send c2 get-height))) 1))
    (send f resize 300 250) (settle 0.6)
    (rel "shrunk")
    (R shrunk:frame>=min (>= (send f get-width) 100))
    (send vp set-alignment 'center 'center) (settle 0.2)
    (R alignment (vals (λ () (send vp get-alignment))))
    ;; Container-Sequence / reflow-container
    (send f begin-container-sequence) (send b1 show #f) (send b2 show #f) (send f end-container-sequence) (settle 0.4)
    (R container-sequence:both-hidden (list (send b1 is-shown?) (send b2 is-shown?)))
    (rel "sequence")
    (send f reflow-container) (settle 0.2)
    (R reflow-ok #t)
    (send f show #f) (settle 0.1)))

;; ---- Tab-Reihenfolge (on-traverse-char, programmatisch) ----
(define (sec-tab-order)
  (parameterize ([current-section "tab-order"])
    (define f (new frame% [label "tab-order"] [width 300] [height 300]))
    (define b1 (new button% [parent f] [label "b1"]))
    (define tf (new text-field% [parent f] [label "tf"]))
    (define cb (new check-box% [parent f] [label "cb"]))
    (define ch (new choice% [parent f] [label "ch"] [choices '("a" "b")]))
    (define b2 (new button% [parent f] [label "b2"]))
    (define names (list (cons b1 'b1) (cons cb 'cb) (cons b2 'b2)))
    (send f show #t) (settle 0.6)
    (for ([i 10] #:unless (eq? (get-top-level-focus-window) f)) (settle 0.2))
    (define (who) (let ([w (send f get-focus-window)])
                    (cond [(assq w names) => cdr] [(not w) #f]
                          [(is-a? w text-field%) 'tf] [(is-a? w choice%) 'ch] [else 'other])))
    (define (tab! shift?)
      (define e (new key-event% [key-code #\tab] [shift-down shift?]))
      (send f on-traverse-char e) (settle 0.25))
    (send b1 focus) (settle 0.4)
    (R start (who))
    (R forward (for/list ([i 6]) (tab! #f) (who)))
    (send b1 focus) (settle 0.3)
    (R backward (for/list ([i 6]) (tab! #t) (who)))
    (send b2 enable #f) (settle 0.2)
    (send cb focus) (settle 0.3)
    (R skip-disabled (begin (tab! #f) (who)))
    (send b2 enable #t)
    (send cb show #f) (settle 0.2)
    (send tf focus) (settle 0.3)
    (R skip-hidden (begin (tab! #f) (who)))
    (R tab-returns-handled? (send f on-traverse-char (new key-event% [key-code #\tab])))
    (send f show #f) (settle 0.1)))

;; ---- Stress: viele Kinder, viele Frames, wiederholtes Erzeugen/Zerstoeren ----
(define (sec-stress)
  (parameterize ([current-section "stress"])
    (define f (new frame% [label "stress"] [width 400] [height 300]))
    (define p (new vertical-panel% [parent f]))
    (send f show #t) (settle 0.3)
    (define kids (for/list ([i 60]) (new button% [parent p] [label (format "b~a" i)])))
    (settle 0.5)
    (R many:children (length (send p get-children)))
    (send p change-children (λ (l) '())) (settle 0.4)
    (R cleared:children (length (send p get-children)))
    (send p change-children (λ (l) kids)) (settle 0.4)
    (R readded:children (length (send p get-children)))
    (for ([k kids]) (send k show #f)) (settle 0.3)
    (R all-hidden (for/and ([k kids]) (not (send k is-shown?))))
    (send f show #f) (set! kids #f) (set! p #f) (set! f #f) (collect-garbage) (settle 0.2)
    (R frames-loop
       (for/list ([i 25])
         (define fr (new frame% [label "x"] [width 200] [height 100]))
         (define pp (new horizontal-panel% [parent fr]))
         (new button% [parent pp] [label "b"]) (new check-box% [parent pp] [label "c"])
         (new choice% [parent pp] [label "ch"] [choices '("a")]) (new list-box% [parent pp] [label #f] [choices '("a")])
         (new canvas% [parent pp]) (new text-field% [parent pp] [label "t"])
         (send fr show #t) (settle 0.03)
         (send fr show #f)
         (when (zero? (modulo i 8)) (collect-garbage))
         i))
    (collect-garbage) (settle 0.3) (collect-garbage)
    (R after-loop-gc #t)
    (define dl (for/list ([i 10])
                 (define d (new dialog% [label "d"] [width 150] [height 80]))
                 (new button% [parent d] [label "x"])
                 (define t (new timer% [notify-callback (λ () (send d show #f))]))
                 (send t start 40 #t) (send d show #t) i))
    (R dialogs-loop (length dl))))


;; ---- Verwaiste Widgets: aus dem Panel entfernt, Referenz weg, GC, danach Ereignisse (Resize, Fokus) ----
(define (sec-orphans)
  (parameterize ([current-section "orphans"])
    (define f (new frame% [label "orphans"] [width 400] [height 300]))
    (define p (new vertical-panel% [parent f]))
    (define keepb (new button% [parent p] [label "keep"]))
    (send f show #t) (settle 0.4)
    (define (make-batch)
      (for/list ([i 6])
        (list (new button% [parent p] [label "b"]) (new check-box% [parent p] [label "c"])
              (new choice% [parent p] [label "ch"] [choices '("a" "b")])
              (new list-box% [parent p] [label #f] [choices '("a" "b")])
              (new canvas% [parent p] [min-height 10]) (new text-field% [parent p] [label "t"])
              (new slider% [parent p] [label "s"] [min-value 0] [max-value 5])
              (new radio-box% [parent p] [label "r"] [choices '("x" "y")])
              (new message% [parent p] [label "m"]) (new gauge% [parent p] [label "g"] [range 5])
              (new group-box-panel% [parent p] [label "gb"]) (new tab-panel% [parent p] [choices '("t1" "t2")]))))
    (for ([round 3])
      (define batch (make-batch))
      (settle 0.2)
      ;; Fokus auf ein Kind, dann entfernen + vergessen
      (send (car (car batch)) focus) (settle 0.2)
      (send p change-children (λ (l) (list keepb)))
      (set! batch #f)
      (collect-garbage) (collect-garbage)
      (send f resize (+ 400 (* round 20)) 300) (settle 0.3)
      (send keepb focus) (settle 0.2)
      (collect-garbage) (settle 0.2))
    (R children-left (length (send p get-children)))
    (R survived #t)
    ;; Dialog-Kinder verwerfen, Frame mit Kindern verwerfen ohne je gezeigt zu werden
    (for ([i 30]) (let ([fr (new frame% [label "never-shown"] [width 100] [height 80])])
                    (new button% [parent fr] [label "x"]) (void)))
    (collect-garbage) (settle 0.3) (collect-garbage) (settle 0.2)
    (R never-shown-frames-gc #t)
    (send f show #f)))

(define sections
  `(("button" . ,sec-button) ("check-box" . ,sec-check-box) ("choice" . ,sec-choice)
    ("list-box" . ,sec-list-box) ("list-box-multi" . ,sec-list-box-multi) ("list-box-columns" . ,sec-list-box-columns)
    ("radio-box" . ,sec-radio-box) ("slider" . ,sec-slider) ("gauge" . ,sec-gauge) ("message" . ,sec-message)
    ("text-field" . ,sec-text-field) ("text-field-multi" . ,sec-text-field-multi) ("combo-field" . ,sec-combo-field)
    ("canvas" . ,sec-canvas) ("editor-canvas" . ,sec-editor-canvas)
    ("panel" . ,sec-panel) ("vertical-panel" . ,sec-vertical-panel) ("horizontal-panel" . ,sec-horizontal-panel)
    ("group-panel" . ,sec-group-panel) ("tab-panel" . ,sec-tab-panel)
    ("frame" . ,sec-frame) ("dialog" . ,sec-dialog) ("menu" . ,sec-menu) ("popup-menu" . ,sec-popup-menu)
    ("clipboard" . ,sec-clipboard) ("cursor" . ,sec-cursor) ("timer" . ,sec-timer)
    ("layout" . ,sec-layout) ("tab-order" . ,sec-tab-order) ("stress" . ,sec-stress) ("orphans" . ,sec-orphans) ("printer-dc" . ,sec-printer) ("message-box" . ,sec-msgbox)
    ,@(for/list ([m shutdown-makers]) (cons (string-append "shutdown-" (car m)) (λ () (shutdown-test (string-append "shutdown-" (car m)) (cdr m)))))))

(module+ main
  (define args (vector->list (current-command-line-arguments)))
  (cond
    [(equal? args '("list")) (for ([s sections]) (displayln (car s)))]
    [else
     (for ([a (if (null? args) (map car sections) args)])
       (define s (assoc a sections))
       (if s
           (with-handlers ([(λ (x) #t) (λ (x) (printf "~a SECTION-EXN ~a\n" a (if (exn? x) (exn-message x) x)))])
             ((cdr s)))
           (printf "unbekannte Sektion ~a\n" a)))
     (printf "DONE\n")
     (exit 0)]))
