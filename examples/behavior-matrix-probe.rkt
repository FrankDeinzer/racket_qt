#lang racket/gui
;; Sammel-Probe (docs/COVERAGE.md, HACKING §81): pro Widget-Klasse eine Reihe von Operationen
;; (Erzeugen, Hide/Show, Enable/Disable-Kaskade, set-label/-value, Getter nach min-size/Resize,
;; Reparent/Delete-Child, Fokus + on-focus, Zerstoeren/GC/Custodian-Shutdown) mit vergleichbarem
;; Protokoll auf stdout:  "<sektion> <schluessel> => <wert>".  Nativ (gtk) und PLT_QT=1 muessen
;; (bis auf dokumentierte 1-px-Differenzen) dasselbe melden:  tests/sweep/behavior-matrix.sh
;; Aufruf: racket examples/behavior-matrix-probe.rkt <sektion> [...]   ("list" nennt die Sektionen)
;; Ausnahme in einer Operation wird als  "EXN <message>"  protokolliert (kein Abbruch).

(define current-section (make-parameter "?"))
(define-syntax-rule (R key e)
  (let ([v (with-handlers ([(λ (x) #t) (λ (x) (format "EXN ~a" (if (exn? x) (car (regexp-split #rx"\n" (exn-message x))) x)))])
             e)])
    (printf "~a ~a => ~s\n" (current-section) 'key v)
    (flush-output)))
(define (settle [s 0.35]) (sleep/yield s))
(define (vals thunk) (call-with-values thunk list))
(define (has? w l) (and (memq w l) #t))

;; ---- on-focus-/on-size-/on-move-Zaehler ----
(define counts (make-hash))
(define (note! who what) (hash-update! counts (cons who what) add1 0))
(define (cnt who what) (hash-ref counts (cons who what) 0))
(define-syntax-rule (L base who)
  (class base
    (define/override (on-focus on?) (note! who (if on? 'focus-in 'focus-out)) (super on-focus on?))
    (define/override (on-size w h) (note! who 'size) (super on-size w h))
    (super-new)))

;; ---- generische Batterie fuer jedes Subwindow ----
(define (generic name mk #:focus? [focus? #t] #:label? [label? #f] #:specific [specific void])
  (parameterize ([current-section name])
    (hash-clear! counts)
    (define f (new frame% [label "bm"] [width 420] [height 320]))
    (define p (new vertical-panel% [parent f]))
    (define pre (new button% [parent p] [label "pre"]))
    (define w (mk p))
    (define post (new button% [parent p] [label "post"]))
    (define p2 (new vertical-panel% [parent f]))
    (send f show #t) (settle)
    (R create:parent-eq (eq? (send w get-parent) p))
    (R create:shown (send w is-shown?))
    (R create:enabled (send w is-enabled?))
    (R create:size>0 (and (> (send w get-width) 0) (> (send w get-height) 0)))
    (R create:xy>=0 (and (>= (send w get-x) 0) (>= (send w get-y) 0)))
    (R create:size#px (list (send w get-width) (send w get-height)))
    (R create:client#px (vals (λ () (send w get-client-size))))
    (R create:min-size#px (list (send w min-width) (send w min-height)))
    (R create:stretch (list (send w stretchable-width) (send w stretchable-height)))
    (when label? (R create:label (send w get-label)))
    ;; Hide/Show
    (define y-before (send post get-y))
    (send w show #f) (settle)
    (R hide:is-shown (send w is-shown?))
    (R hide:in-children (has? w (send p get-children)))
    (R hide:neighbour-moved-up (< (send post get-y) y-before))
    (send w show #t) (settle)
    (R show:is-shown (send w is-shown?))
    (R show:neighbour-back (= (send post get-y) y-before))
    ;; Hide-Kaskade ueber den Container
    (send p show #f) (settle)
    (R cascade-hide:parent-shown (send p is-shown?))
    (R cascade-hide:child-shown (send w is-shown?))
    (send p show #t) (settle)
    (R cascade-show:child-shown (send w is-shown?))
    ;; Enable/Disable
    (send w enable #f) (settle)
    (R disable:is-enabled (send w is-enabled?))
    (send w enable #t) (settle)
    (R enable:is-enabled (send w is-enabled?))
    (send p enable #f) (settle)
    (R cascade-disable:parent (send p is-enabled?))
    (R cascade-disable:child (send w is-enabled?))
    (R cascade-disable:pre (send pre is-enabled?))
    (send w enable #t)
    (R cascade-disable:child-after-own-enable (send w is-enabled?))
    (send p enable #t) (settle)
    (R cascade-enable:child (send w is-enabled?))
    ;; Mindestgroesse -> Getter
    (send w stretchable-width #f) (send w stretchable-height #f)
    (send w min-width 173) (send w min-height 47) (settle)
    (R minsize:getters (list (send w min-width) (send w min-height)))
    (R minsize:size>=min (and (>= (send w get-width) 173) (>= (send w get-height) 47)))
    (R minsize:size#px (list (send w get-width) (send w get-height)))
    (send f resize 560 430) (settle)
    (R frame-resize:size#px (list (send f get-width) (send f get-height)))
    (R frame-resize:w-keeps-min (and (>= (send w get-width) 173)))
    (R frame-resize:size-count>=1 (>= (cnt 'w 'size) 1))
    (send w min-width 0) (send w min-height 0)
    (send w stretchable-width #t) (send w stretchable-height #t)
    ;; Reparent / Delete-Child
    (send w reparent p2) (settle)
    (R reparent:parent-eq (eq? (send w get-parent) p2))
    (R reparent:children (list (length (send p get-children)) (length (send p2 get-children))))
    (R reparent:shown (send w is-shown?))
    (R reparent:size>0 (and (> (send w get-width) 0) (> (send w get-height) 0)))
    (send p2 delete-child w) (settle)
    (R delete-child:children (length (send p2 get-children)))
    (send p2 add-child w) (settle)
    (R add-child:children (length (send p2 get-children)))
    (send p2 change-children (λ (l) '())) (settle)
    (R change-children-empty:children (length (send p2 get-children)))
    (send p2 change-children (λ (l) (list w))) (settle)
    (R change-children-back:children (length (send p2 get-children)))
    (R change-children-back:shown (send w is-shown?))
    ;; Fokus
    (when focus?
      (send f show #t)
      (settle 0.5)
      (for ([i 10] #:unless (eq? (get-top-level-focus-window) f)) (settle 0.2)) ; WM-Aktivierung abwarten (sonst flaky)
      (R focus:accepts (send w accept-tab-focus))
      (send w focus) (settle 0.5)
      (R focus:has-focus (send w has-focus?))
      (R focus:frame-focus-window-eq (eq? (send f get-focus-window) w))
      (R focus:on-focus-in-count (cnt 'w 'focus-in))
      (send pre focus) (settle 0.5)
      (R focus:moved-to-pre (send pre has-focus?))
      (R focus:old-lost (not (send w has-focus?)))
      (R focus:on-focus-out-count (cnt 'w 'focus-out)))
    ;; klassenspezifisch
    (specific w f)
    ;; Zerstoeren
    (send f show #f) (settle 0.2)
    (R destroy:frame-shown (send f is-shown?))
    (send p2 change-children (λ (l) '())) (settle 0.1)
    (set! f #f) (set! p #f) (set! p2 #f) (set! w #f) (set! pre #f) (set! post #f)
    (collect-garbage) (settle 0.2) (collect-garbage)
    (R destroy:gc-ok #t)))

(define-syntax-rule (mk-fn cls . args) (λ (p) (new (L cls 'w) [parent p] . args)))

;; ---- Sektionen ----
(define (sec-button)
  (define hits 0)
  (generic "button" #:label? #t
           (mk-fn button% [label "Hello"] [callback (λ (b e) (set! hits (add1 hits)))])
           #:specific
           (λ (w f)
             (define wd (send w get-width))
             (send w set-label "A much longer label") (settle)
             (R setlabel:get (send w get-label))
             (R setlabel:grew (> (send w get-width) wd))
             (send w command (new control-event% [event-type 'button]))
             (R command:callback-hits hits)
             (send w enable #f) (settle)
             (send w set-label "Dis") (settle)
             (R setlabel-disabled:get (send w get-label))
             (send w enable #t))))
(define (sec-check-box)
  (define hits 0)
  (generic "check-box" #:label? #t
           (mk-fn check-box% [label "Check"] [callback (λ (b e) (set! hits (add1 hits)))])
           #:specific
           (λ (w f)
             (R value:initial (send w get-value))
             (send w set-value #t) (settle)
             (R value:set-true (send w get-value))
             (R value:callback-hits-after-set hits)
             (send w set-label "Renamed") (settle)
             (R setlabel:get (send w get-label))
             (send w command (new control-event% [event-type 'check-box]))
             (R command:hits hits)
             (send w set-value #f) (settle)
             (R value:set-false (send w get-value)))))
(define (sec-choice)
  (define hits 0)
  (generic "choice" #:label? #t
           (mk-fn choice% [label "Ch"] [choices '("a" "bb" "ccc")] [callback (λ (b e) (set! hits (add1 hits)))])
           #:specific
           (λ (w f)
             (R init:n+sel (list (send w get-number) (send w get-selection) (send w get-string-selection)))
             (send w set-selection 2) (settle)
             (R setsel:sel (list (send w get-selection) (send w get-string-selection)))
             (send w append "dddd") (settle)
             (R append:n+str (list (send w get-number) (send w get-string 3)))
             (R find-string (send w find-string "bb"))
             (send w set-string 0 "AAA") (settle)
             (R setstring (send w get-string 0))
             (send w delete 0) (settle)
             (R delete:n+sel (list (send w get-number) (send w get-selection)))
             (send w set-selection 0) (settle)
             (R setsel0 (send w get-string-selection))
             (send w clear) (settle)
             (R clear:n (send w get-number))
             (send w append "x") (settle)
             (R append-after-clear (list (send w get-number) (send w get-selection)))
             (R callback-hits-after-programmatic hits))))
(define (sec-list-box)
  (generic "list-box" #:label? #t
           (mk-fn list-box% [label "LB"] [choices '("one" "two" "three")] [style '(single)])
           #:specific
           (λ (w f)
             (R init:n (send w get-number))
             (send w set-selection 1) (settle)
             (R setsel (list (send w get-selection) (send w get-string-selection) (send w get-selections)))
             (send w append "four") (settle)
             (R append:n+str (list (send w get-number) (send w get-string 3)))
             (send w append "five" 'datum) (settle)
             (R append-data (send w get-data 4))
             (send w set-string 0 "ONE") (settle)
             (R setstring (send w get-string 0))
             (send w delete 0) (settle)
             (R delete:n+sel (list (send w get-number) (send w get-selection)))
             (send w set-first-visible-item 1) (settle)
             (R first-visible (send w get-first-visible-item))
             (R visible-count>0 (> (send w number-of-visible-items) 0))
             (send w set (list "p" "q")) (settle)
             (R set:n (send w get-number))
             (send w clear) (settle)
             (R clear:n+sel (list (send w get-number) (send w get-selection))))))
(define (sec-list-box-multi)
  (generic "list-box-multi" #:label? #t
           (mk-fn list-box% [label "LBM"] [choices '("one" "two" "three" "four")] [style '(multiple)])
           #:specific
           (λ (w f)
             (send w select 0 #t) (send w select 2 #t) (settle)
             (R selections (send w get-selections))
             (R is-selected (list (send w is-selected? 0) (send w is-selected? 1) (send w is-selected? 2)))
             (send w select 0 #f) (settle)
             (R deselect (send w get-selections))
             (send w set-selection 3) (settle)
             (R setsel (send w get-selections))
             (send w delete 3) (settle)
             (R delete-selected:sel (send w get-selections)))))
(define (sec-list-box-columns)
  (generic "list-box-columns" #:label? #t
           (mk-fn list-box% [label "LBC"] [choices '()] [style '(single column-headers)]
                  [columns '("A" "B" "C")])
           #:specific
           (λ (w f)
             (send w append "r1") (send w append "r2") (settle)
             (send w set-string 0 "r1b" 1) (send w set-string 0 "r1c" 2) (settle)
             (R cells (list (send w get-string 0 0) (send w get-string 0 1) (send w get-string 0 2)))
             (R n (send w get-number))
             (R column-order (send w get-column-order))
             (send w set-column-label 1 "Bee") (settle)
             (R column-label (list (send w get-column-labels)))
             (R column-size#px (let-values ([(w0 mn mx) (send w get-column-size 0)]) (list (number? w0) mn mx)))
             (send w set-column-size 0 80 20 200) (settle)
             (R column-size-set#px (let-values ([(w0 mn mx) (send w get-column-size 0)]) (list w0 mn mx)))
             (send w set (list "x" "y" "z") (list "x2" "y2" "z2")) (settle)
             (R set:n+cell (list (send w get-number) (send w get-string 1 1)))
             (send w delete-column 2) (settle)
             (R delete-column (send w get-column-labels))
             (send w append-column "D") (settle)
             (R append-column (send w get-column-labels)))))
(define (sec-radio-box)
  (generic "radio-box" #:label? #t
           (mk-fn radio-box% [label "Radio"] [choices '("r1" "r2" "r3")])
           #:specific
           (λ (w f)
             (R init:sel+n (list (send w get-selection) (send w get-number)))
             (send w set-selection 2) (settle)
             (R setsel (send w get-selection))
             (R item-label (list (send w get-item-label 0) (send w get-item-label 2)))
             (send w enable 1 #f) (settle)
             (R item-enabled (list (send w is-enabled? 0) (send w is-enabled? 1)))
             (R whole-enabled (send w is-enabled?))
             (send w enable 1 #t)
             (send w show 1 #f) (settle)
             (R item-shown (list (send w is-shown?)))
             (send w show 1 #t) (settle)
             (send w set-item-label 0 "renamed") (settle)
             (R set-item-label (send w get-item-label 0)))))
(define (sec-slider)
  (generic "slider" #:label? #t
           (mk-fn slider% [label "Sl"] [min-value 0] [max-value 50] [init-value 10])
           #:specific
           (λ (w f)
             (R init (send w get-value))
             (send w set-value 33) (settle)
             (R set (send w get-value))
             (send w set-value 500) (settle)
             (R set-out-of-range (send w get-value))
             (send w set-value -9) (settle)
             (R set-below (send w get-value))
             (send w command (new control-event% [event-type 'slider])) (settle)
             (R command-ok #t))))
(define (sec-gauge)
  (generic "gauge" #:label? #t #:focus? #f
           (mk-fn gauge% [label "G"] [range 100])
           #:specific
           (λ (w f)
             (R init (list (send w get-value) (send w get-range)))
             (send w set-value 40) (settle)
             (R set (send w get-value))
             (send w set-range 200) (settle)
             (R set-range (list (send w get-range) (send w get-value)))
             (send w set-value 999) (settle)
             (R set-over (send w get-value)))))
(define (sec-message)
  (generic "message" #:label? #t #:focus? #f
           (mk-fn message% [label "msg"])
           #:specific
           (λ (w f)
             (define wd (send w get-width))
             (send w set-label "a considerably longer message label") (settle)
             (R setlabel (send w get-label))
             (R grew (> (send w get-width) wd))
             (send w set-label "") (settle)
             (R empty-label (send w get-label))
             (R auto-resize (send w auto-resize))
             (send w set-label "x") (settle)
             (R color (send w get-color)))))
(define (sec-text-field)
  (define hits 0)
  (generic "text-field" #:label? #t
           (mk-fn text-field% [label "TF"] [init-value "init"] [callback (λ (b e) (set! hits (add1 hits)))])
           #:specific
           (λ (w f)
             (R init (send w get-value))
             (send w set-value "changed") (settle)
             (R set (send w get-value))
             (R callback-after-set hits)
             (send w set-label "L2") (settle)
             (R setlabel (send w get-label))
             (send (send w get-editor) insert "++") (settle)
             (R editor-insert (send w get-value))
             (send w set-value "") (settle)
             (R cleared (send w get-value)))))
(define (sec-text-field-multi)
  (generic "text-field-multi" #:label? #t
           (mk-fn text-field% [label #f] [init-value "l1\nl2"] [style '(multiple)])
           #:specific
           (λ (w f)
             (R init (send w get-value))
             (send w set-value "a\nb\nc") (settle)
             (R set (send w get-value))
             (R lines (send (send w get-editor) last-paragraph)))))
(define (sec-combo-field)
  (generic "combo-field" #:label? #t
           (mk-fn combo-field% [label "CF"] [choices '("x" "y")] [init-value "xx"])
           #:specific
           (λ (w f)
             (R init (send w get-value))
             (send w append "zz") (settle)
             (R append:n (send w get-number))
             (send w set-value "new") (settle)
             (R set (send w get-value)))))
(define (sec-canvas)
  (define paints 0)
  (generic "canvas"
           (λ (p) (new (class (L canvas% 'w)
                         (define/override (on-paint) (set! paints (add1 paints)))
                         (super-new))
                       [parent p] [min-width 80] [min-height 40]))
           #:specific
           (λ (w f)
             (R init:paint>=1 (>= paints 1))
             (define n paints)
             (send w refresh) (settle)
             (R refresh:paint-more (> paints n))
             (R dc-size#px (vals (λ () (send (send w get-dc) get-size))))
             (R client-eq-dc (equal? (vals (λ () (send w get-client-size)))
                                     (map exact-round (vals (λ () (send (send w get-dc) get-size))))))
             (R scrollbars:init#info (send w init-auto-scrollbars 500 500 0.0 0.0)) (settle)
             (R scrollbars:virtual#px (vals (λ () (send w get-virtual-size))))
             (R scrollbars:scroll-pos (list (send w get-scroll-pos 'vertical) (send w get-scroll-pos 'horizontal)))
             (R scrollbars:scroll#info (send w scroll 0.5 0.5)) (settle)
             (R scrollbars:view-start#px (vals (λ () (send w get-view-start))))
             (R scrollbars:hide#info (send w show-scrollbars #f #f)) (settle)
             (R scrollbars:hidden-client#px (vals (λ () (send w get-client-size))))
             (send w set-canvas-background (make-object color% 10 20 30))
             (R background (let ([c (send w get-canvas-background)]) (and c (list (send c red) (send c green) (send c blue)))))
             (send w set-label "lbl")
             (R canvas-label (send w get-label))
             (R cursor-set (begin (send w set-cursor (make-object cursor% 'watch)) (and (send w get-cursor) #t))))))
(define (sec-editor-canvas)
  (define t (new text%))
  (send t insert (apply string-append (for/list ([i 200]) (format "line ~a\n" i))))
  (generic "editor-canvas"
           (mk-fn editor-canvas% [editor t] [min-width 100] [min-height 60])
           #:specific
           (λ (w f)
             (R editor-eq (eq? (send w get-editor) t))
             (send w scroll-to 0 0 1 1 #t) (settle)
             (send t set-position 3000) (settle)
             (R scrolled-down (> (send t scroll-editor-to 0 0 1 1 #f #f) -1))
             (R view-start-y>0 (let-values ([(x y) (send w get-view-start)]) (list (exact? x))))
             (send w set-editor #f) (settle)
             (R set-editor-none (send w get-editor))
             (send w set-editor t) (settle)
             (R set-editor-back (eq? (send w get-editor) t)))))
(define (container-test name cls)
  (generic name #:focus? #f
           (λ (p) (define c (new (L cls 'w) [parent p]))
                  (new button% [parent c] [label "child-a"])
                  (new button% [parent c] [label "child-b"])
                  c)
           #:specific
           (λ (w f)
             (R children (length (send w get-children)))
             (define a (car (send w get-children)))
             (send a show #f) (settle)
             (R child-hidden (list (send a is-shown?) (send w get-width)))
             (send a show #t)
             (send w enable #f) (settle)
             (R child-cascade (send a is-enabled?))
             (send w enable #t) (settle)
             (R spacing/border (list (send w spacing) (send w border)))
             (R alignment (vals (λ () (send w get-alignment))))
             (send w set-alignment 'right 'bottom)
             (R set-alignment (vals (λ () (send w get-alignment))))
             (send w delete-child a) (settle)
             (R delete-child:children (length (send w get-children)))
             (send w add-child a) (settle)
             (R readd:children (length (send w get-children)))
             (R client-size>0 (let-values ([(cw ch) (send w get-client-size)]) (and (> cw 0) (> ch 0)))))))
(define (sec-panel) (container-test "panel" panel%))
(define (sec-vertical-panel) (container-test "vertical-panel" vertical-panel%))
(define (sec-horizontal-panel) (container-test "horizontal-panel" horizontal-panel%))
(define (sec-group-panel)
  (generic "group-panel" #:focus? #f #:label? #t
           (λ (p) (define c (new (L group-box-panel% 'w) [parent p] [label "Group"]))
                  (new button% [parent c] [label "in-group"]) c)
           #:specific
           (λ (w f)
             (R children (length (send w get-children)))
             (define-values (cw ch) (send w get-client-size))
             (R client<size (and (<= cw (send w get-width)) (<= ch (send w get-height))))
             (send w set-label "Renamed") (settle)
             (R setlabel (send w get-label))
             (send w enable #f) (settle)
             (R child-disabled (send (car (send w get-children)) is-enabled?))
             (send w enable #t))))
(define (sec-tab-panel)
  (define hits 0)
  (generic "tab-panel" #:focus? #f
           (λ (p) (define c (new (L tab-panel% 'w) [parent p] [choices '("T1" "T2" "T3")]
                                 [callback (λ (t e) (set! hits (add1 hits)))]))
                  (new button% [parent c] [label "in-tab"]) c)
           #:specific
           (λ (w f)
             (R init (list (send w get-number) (send w get-selection)))
             (send w set-selection 2) (settle)
             (R setsel (send w get-selection))
             (R callback-after-set hits)
             (R item-label (send w get-item-label 1))
             (send w set-item-label 1 "Two") (settle)
             (R set-item-label (send w get-item-label 1))
             (send w append "T4") (settle)
             (R append (list (send w get-number) (send w get-item-label 3)))
             (send w delete 0) (settle)
             (R delete (list (send w get-number) (send w get-selection)))
             (define-values (cw ch) (send w get-client-size))
             (R client<size (and (<= cw (send w get-width)) (< ch (send w get-height))))
             (R find-string (send w get-item-label 2)))))
(define (sec-frame)
  (parameterize ([current-section "frame"])
    (hash-clear! counts)
    (define closes 0)
    (define f (new (class frame%
                     (define/augment (on-close) (set! closes (add1 closes)))
                     (define/override (on-size w h) (note! 'f 'size) (super on-size w h))
                     (define/override (on-move x y) (note! 'f 'move) (super on-move x y))
                     (define/override (on-activate on?) (note! 'f (if on? 'act 'deact)) (super on-activate on?))
                     (super-new))
                   [label "frame-a"] [width 321] [height 234] [x 100] [y 120]))
    (define b (new (L button% 'b) [parent f] [label "btn"]))
    (R create:shown-before (send f is-shown?))
    (send f show #t) (settle 0.6)
    (R show:shown (send f is-shown?))
    (R show:size#px (list (send f get-width) (send f get-height)))
    (R show:client-lt-size (let-values ([(w h) (send f get-client-size)]) (and (<= w 321) (<= h 234) (> w 0))))
    (R show:pos-requested#px (list (send f get-x) (send f get-y)))
    (R label (send f get-label))
    (send f set-label "frame-b") (settle) (R set-label (send f get-label))
    (send f move 200 210) (settle) (R move:xy#px (list (send f get-x) (send f get-y)))
    (R move:on-move>=1 (>= (cnt 'f 'move) 1))
    (send f resize 400 300) (settle) (R resize:size#px (list (send f get-width) (send f get-height)))
    (R resize:on-size>=1 (>= (cnt 'f 'size) 1))
    (send f set-label "x")
    (R center (begin (send f center) (settle) (let-values ([(w h) (get-display-size)]) (let ([x (send f get-x)] [y (send f get-y)]) (and (>= x 0) (>= y 0) (< x w))))))
    ;; Zustaende
    (send f iconize #t) (settle 0.6) (R iconize:is-iconized (send f is-iconized?))
    (send f iconize #f) (settle 0.6) (R restore:is-iconized (send f is-iconized?))
    (send f maximize #t) (settle 0.6) (R maximize:is-maximized (send f is-maximized?))
    (R maximize:size>old (> (send f get-width) 400))
    (send f maximize #f) (settle 0.6) (R unmaximize:is-maximized (send f is-maximized?))
    (R unmaximize:size#px (list (send f get-width) (send f get-height)))
    (send f fullscreen #t) (settle 0.6) (R fullscreen:is (send f is-fullscreened?))
    (send f fullscreen #f) (settle 0.6) (R fullscreen-off:is (send f is-fullscreened?))
    ;; Enable-Kaskade
    (send f enable #f) (settle) (R disable:frame (send f is-enabled?)) (R disable:child (send b is-enabled?))
    (send f enable #t) (settle) (R enable:child (send b is-enabled?))
    ;; Fokus / Aktivierung
    (for ([i 10] #:unless (eq? (get-top-level-focus-window) f)) (settle 0.2))
    (send b focus) (settle 0.5)
    (R focus:button#info (send b has-focus?))
    (R focus:focus-window-eq#info (eq? (send f get-focus-window) b))
    (R focus:focus-member-eq#info (eq? (send f get-focus-member) b))
    (R activate:on-activate>=1 (>= (cnt 'f 'act) 1))
    (R activate:frame-active?#info (eq? (get-top-level-focus-window) f)) ; Info (WM-abhaengig)
    ;; Status-Zeile, Modified, Menueleiste
    (send f create-status-line) (send f set-status-text "status") (settle)
    (R status:has-status-line (send f has-status-line?))
    (send f modified #t) (R modified (send f modified))
    (send f modified #f)
    (R edge-insets#px (vals (λ () (send f get-display-left-top-inset))))
    ;; Hide/Show/on-close
    (send f show #f) (settle) (R hide:shown (send f is-shown?))
    (send f show #t) (settle) (R reshow:shown (send f is-shown?))
    (R reshow:size>0 (and (> (send f get-width) 0) (> (send f get-height) 0)))
    (send f show #f) (settle)
    (R on-close-count-after-programmatic-hide closes)
    (R eventspace-eq (eq? (send f get-eventspace) (current-eventspace)))
    (send f show #t) (settle)
    (send f on-exit) (settle) ; ruft on-close, dann show #f?
    (R on-exit:on-close-count closes)
    (R on-exit:shown (send f is-shown?))
    (set! f #f) (collect-garbage) (settle 0.1)))
