#lang racket/base
;; §71: Minimalgroessen/Layout fuer die Kosmetik-Punkte (slider, tab-panel, mehrspaltige list-box).
;; Vergleich: racket examples/cosmetic-sizes-probe.rkt  vs  PLT_QT=1 racket ...
(require racket/gui/base racket/class)
(define f (new frame% [label "cosmetic"] [width 400] [height 500]))
(define (rep name w) (let-values ([(a b) (send w get-graphical-min-size)]) (printf "~a min ~ax~a\n" name a b)))
(define s (new slider% [parent f] [label #f] [min-value 0] [max-value 100] [init-value 40]))
(define sl (new slider% [parent f] [label "lbl"] [min-value 0] [max-value 100] [init-value 40]))
(define lb0 (new list-box% [parent f] [label #f] [choices '("a" "b" "c")]))
(define lb1 (new list-box% [parent f] [label #f] [choices '()] [style '(single column-headers)] [columns '("Name" "Kind" "Size")]))
(send lb1 set '("alpha" "beta" "gamma") '("a" "b" "c") '("1" "2" "3"))
(define lb2 (new list-box% [parent f] [label #f] [choices '()] [style '(single column-headers)] [columns '("Name" "Kind")]))
(define lb3 (new list-box% [parent f] [label #f] [choices '()] [style '(single column-headers)] [columns '("Name" "Kind")]))
(send lb3 set (for/list ([i 50]) (format "n~a" i)) (for/list ([i 50]) "k"))
(define tp (new tab-panel% [parent f] [choices '("One" "Two")]))
(new message% [parent tp] [label "content"])
(send f show #t)
(yield)
(for ([p (list (cons "slider" s) (cons "slider-lbl" sl) (cons "list-single" lb0) (cons "tree3rows" lb1) (cons "tree-empty" lb2) (cons "tree50" lb3) (cons "tab-panel" tp))])
  (rep (car p) (cdr p)))
(printf "frame ~a x ~a\n" (send f get-width) (send f get-height))
(for ([p (list (cons "slider" s) (cons "list-single" lb0) (cons "tree3rows" lb1) (cons "tree-empty" lb2) (cons "tab-panel" tp))])
  (printf "~a size ~ax~a\n" (car p) (send (cdr p) get-width) (send (cdr p) get-height)))
(exit 0)
