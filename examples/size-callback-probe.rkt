#lang racket/gui
;; Probe (HACKING §80): on-size/on-move fuer NICHT-Canvas-Widgets/Panels und programmatisches
;; frame% `resize` mit Kind-Reflow.  Ohne Display-Wartezeit-Tricks: nur sleep/yield.  Nativ (gtk)
;; und PLT_QT=1 muessen dasselbe melden.
(define log (make-hash))
(define (note! who what) (hash-update! log (cons who what) add1 0))
(define-syntax-rule (logging-class base who)
  (class base
    (define/override (on-size w h) (note! who 'on-size) (super on-size w h))
    (define/override (on-move x y) (note! who 'on-move) (super on-move x y))
    (super-new)))
(define f (new (class frame%
                 (define/override (on-size w h) (note! 'frame 'on-size) (super on-size w h))
                 (super-new [label "size-probe"] [width 300] [height 200]))))
(define p (new (logging-class horizontal-panel% 'panel) [parent f]))
(define b (new (logging-class button% 'button) [parent p] [label "B"]))
(define m (new (logging-class message% 'message) [parent p] [label "hello"] [stretchable-width #t]))
(define c (new (logging-class canvas% 'canvas) [parent p] [min-width 50] [min-height 50]))
(send f show #t)
(sleep/yield 1)
(define (sizes) (list (send f get-width) (send c get-width) (send c get-height) (send p get-width)))
(define s0 (sizes))
(printf "initial: ~a\n" s0)
(hash-clear! log)
(send f resize 500 400)
(sleep/yield 1)
(define s1 (sizes))
(printf "nach (send f resize 500 400): ~a\n" s1)
(for ([k '(panel button message canvas frame)])
  (printf "  ~a on-size=~a on-move=~a\n" k (hash-ref log (cons k 'on-size) 0) (hash-ref log (cons k 'on-move) 0)))
(define reflow? (> (cadr s1) (cadr s0)))
(define sizes-ok? (and (>= (hash-ref log '(panel . on-size) 0) 1)
                       (>= (hash-ref log '(button . on-size) 0) 0)
                       (>= (hash-ref log '(canvas . on-size) 0) 1)))
(printf "Kind-Reflow: ~a, on-size panel+canvas: ~a\n" reflow? sizes-ok?)
(printf "~a\n" (if (and reflow? sizes-ok?) "PASS" "FAIL"))
(exit (if (and reflow? sizes-ok?) 0 1))
